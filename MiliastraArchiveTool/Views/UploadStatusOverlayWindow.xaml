<Window x:Class="MiliastraArchiveTool.Views.UploadStatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280"
        Height="224"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Opacity="1"
        Background="Transparent">
    <Border x:Name="RootBorder"
            Background="#B31A2234"
            BorderBrush="#99FFFFFF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Ellipse x:Name="StateDot"
                         Width="9"
                         Height="9"
                         Fill="#60A5FA"
                         Margin="0,0,7,0"
                         VerticalAlignment="Center"/>
                <TextBlock Text="Save Upload Status"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="13"/>
                <TextBlock x:Name="ElapsedText"
                           DockPanel.Dock="Right"
                           Foreground="#F8FAFC"
                           FontSize="11"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <TextBlock x:Name="ModeText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       Foreground="#F8FAFC"
                       FontSize="11"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="TaskText" TextWrapping="Wrap" MaxHeight="34"
                       Grid.Row="2"
                       Margin="0,7,0,0"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="PhaseText"
                       Grid.Row="3"
                       TextWrapping="Wrap" MaxHeight="51"
                       Margin="0,4,0,0"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"/>

            <ProgressBar x:Name="OverallProgress"
                         Grid.Row="4"
                         Height="5"
                         Margin="0,10,0,0"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>

            <TextBlock Grid.Row="5"
                       Margin="0,7,0,0"
                       Foreground="#E2E8F0"
                       FontSize="10"
                       Text="F9 Start / F10 Stop"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock x:Name="SummaryText"
                       Grid.Row="6"
                       Margin="0,6,0,0"
                       Foreground="#F8FAFC"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxHeight="32"/>
        </Grid>
    </Border>
</Window>
