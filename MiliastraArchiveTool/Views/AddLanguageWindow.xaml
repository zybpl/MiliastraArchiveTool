<Window x:Class="MiliastraArchiveTool.Views.AddLanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Loc[AddLanguage], Mode=OneWay}"
        Width="720"
        Height="560"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="LanguagePill" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="8,6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill"
                                Height="38"
                                Background="White"
                                BorderBrush="#C8D0DA"
                                BorderThickness="1"
                                CornerRadius="18">
                            <Grid>
                                <Ellipse x:Name="Dot"
                                         Width="18"
                                         Height="18"
                                         Margin="11,0,0,0"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Fill="#F1F5F9"
                                         Stroke="#C8D0DA"/>
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           Width="18"
                                           Height="18"
                                           Margin="11,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Foreground="White"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#8FB5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#9CA3AF"/>
                                <Setter TargetName="Dot" Property="Fill" Value="#22C55E"/>
                                <Setter TargetName="Dot" Property="Stroke" Value="#22C55E"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#1F2A44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Loc[AddLanguage], Mode=OneWay}"
                   FontSize="24"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,14"/>

        <ListBox x:Name="LanguageList"
                 Grid.Row="1"
                 ItemsSource="{Binding Languages}"
                 SelectionMode="Multiple"
                 ItemContainerStyle="{StaticResource LanguagePill}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="{Binding Loc[Confirm], Mode=OneWay}" Width="220" Height="42" Margin="8,0" Style="{StaticResource PrimaryDialogButton}" Click="Confirm_OnClick"/>
            <Button Content="{Binding Loc[Cancel], Mode=OneWay}" Width="160" Height="42" Margin="8,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
