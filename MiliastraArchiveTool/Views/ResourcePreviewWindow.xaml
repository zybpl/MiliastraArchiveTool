<Window x:Class="MiliastraArchiveTool.Views.ResourcePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [ResourcePreviewTitle]}"
        Width="960"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#202020">
    <Window.Resources>
        <Style x:Key="PreviewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#8FB5FF"/>
            <Setter Property="Foreground" Value="#174EA6"/>
        </Style>
    </Window.Resources>
    <Grid Background="#202020">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="ImagePreview"
               Margin="12"
               Stretch="Uniform"
               Visibility="Collapsed"/>

        <MediaElement x:Name="VideoPreview"
                      Margin="12"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="Uniform"
                      Visibility="Collapsed"
                      MediaFailed="VideoPreview_OnMediaFailed"/>

        <Border Grid.Row="1" Background="#303030" Padding="6">
            <DockPanel LastChildFill="True">
            <StackPanel x:Name="VideoControls"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <Button Content="{Binding [Play]}" Style="{StaticResource PreviewButton}" Click="Play_OnClick"/>
                <Button Content="{Binding [Pause]}" Style="{StaticResource PreviewButton}" Click="Pause_OnClick"/>
                <Button Content="{Binding [Stop]}" Style="{StaticResource PreviewButton}" Click="Stop_OnClick"/>
            </StackPanel>
            <TextBlock x:Name="PathText"
                       Margin="12,8"
                       Foreground="#DDDDDD"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
