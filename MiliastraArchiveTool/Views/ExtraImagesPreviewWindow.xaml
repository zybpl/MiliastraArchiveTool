<Window x:Class="MiliastraArchiveTool.Views.ExtraImagesPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [ExtraImagesTitle], Mode=OneWay}"
        Width="1050"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="InfoDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E8F1FF"/>
            <Setter Property="BorderBrush" Value="#93B7F4"/>
            <Setter Property="Foreground" Value="#174EA6"/>
        </Style>
        <Style x:Key="DangerDialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>
        <Style x:Key="WindowCaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <TextBlock Text="{Binding [ExtraImagesTitle], Mode=OneWay}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="&#xE711;"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,14,0"
                        Style="{StaticResource WindowCaptionButton}"
                        Click="Close_OnClick"/>
            </Grid>

            <Grid Grid.Row="1" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="{Binding [ImageList], Mode=OneWay}" Grid.Column="0">
                    <DockPanel Margin="6">
                        <TextBlock x:Name="CountText"
                                   DockPanel.Dock="Top"
                                   Margin="4"
                                   Foreground="#666"/>
                        <StackPanel DockPanel.Dock="Bottom">
                            <Button Content="{Binding [OpenSeparatePreview], Mode=OneWay}"
                                    Height="32"
                                    Margin="4"
                                    Style="{StaticResource InfoDialogButton}"
                                    Click="PreviewSelected_OnClick"/>
                            <Button Content="{Binding [DeleteSelectedImage], Mode=OneWay}"
                                    Height="32"
                                    Margin="4"
                                    Style="{StaticResource DangerDialogButton}"
                                    Click="DeleteSelected_OnClick"/>
                        </StackPanel>
                        <ListBox x:Name="ImageList"
                                 Margin="4"
                                 SelectionChanged="ImageList_OnSelectionChanged"
                                 MouseDoubleClick="ImageList_OnMouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="48" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail, Mode=OneWay}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding FileName, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="{Binding [LargePreview], Mode=OneWay}" Grid.Column="2">
                    <Border Background="#202020" CornerRadius="8" Padding="10">
                        <Grid>
                            <Image x:Name="LargePreview" Stretch="Uniform"/>
                            <TextBlock x:Name="EmptyTip"
                                       Text="{Binding [NoPreviewImage], Mode=OneWay}"
                                       Foreground="#DDD"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </Border>
</Window>
